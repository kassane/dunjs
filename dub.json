{
    "name": "dunjs",
    "description": "A secure JavaScript runtime written in D",
    "authors": ["Matheus C. Franca"],
    "license": "MIT",

    "targetType": "executable",
    "targetName": "dun",
    "targetPath": "build",

    "sourcePaths": ["source"],
    "importPaths": ["source"],
    "stringImportPaths": ["source"],

    "toolchainRequirements": {
        "frontend": ">=2.112"
    },

    "dflags-ldc": ["-preview=all"],
    "dflags-dmd": ["-preview=shortenedMethods", "-preview=fixImmutableConv", "-preview=fixAliasThis", "-preview=rvalueRefParam"],

    "libs-linux": ["m", "dl", "pthread"],
    "libs-osx": ["m", "pthread"],

    "buildTypes": {
        "release": {
            "dflags": ["-O", "-release", "-boundscheck=off"],
            "lflags-posix": ["-s"]
        },
        "release-debug": {
            "dflags": ["-O", "-g"]
        }
    },

    "configurations": [
        {
            "name": "quickjs",
            "versions": ["EngineQuickJS"],
            "preBuildCommands-posix": [
                "$DC -run $PACKAGE_DIR/build.d --backend=quickjs"
            ],
            "excludedSourceFiles": [
                "source/dun/engine/jsc/backend.d",
                "source/dun/engine/jsc/cppbindings.d",
                "source/dun/engine/v8/backend.d",
                "source/dun/engine/v8/cppbindings.d"
            ],
            "libs-posix": ["qjs"],
            "lflags-posix": ["-L$PACKAGE_DIR/vendor/quickjs/build"]
        },
        {
            "name": "jsc",
            "versions": ["EngineJSC"],
            "preBuildCommands-posix": [
                "$DC -run $PACKAGE_DIR/build.d --backend=jsc"
            ],
            "excludedSourceFiles": [
                "source/dun/engine/quickjs/backend.d",
                "source/dun/engine/quickjs/context.d",
                "source/dun/engine/quickjs/runtime.d",
                "source/dun/engine/quickjs/value.d",
                "source/dun/engine/quickjs/exceptions.d",
                "source/dun/engine/quickjs/function_bind.d",
                "source/dun/engine/v8/backend.d",
                "source/dun/engine/v8/cppbindings.d"
            ],
            "libs-linux": ["javascriptcoregtk-4.1"],
            "lflags-osx": ["-framework", "JavaScriptCore"]
        },
        {
            "name": "v8",
            "versions": ["EngineV8"],
            "preBuildCommands-posix": [
                "$DC -run $PACKAGE_DIR/build.d --backend=v8"
            ],
            "excludedSourceFiles": [
                "source/dun/engine/quickjs/backend.d",
                "source/dun/engine/quickjs/context.d",
                "source/dun/engine/quickjs/runtime.d",
                "source/dun/engine/quickjs/value.d",
                "source/dun/engine/quickjs/exceptions.d",
                "source/dun/engine/quickjs/function_bind.d",
                "source/dun/engine/jsc/backend.d",
                "source/dun/engine/jsc/cppbindings.d"
            ],
            "libs-linux": ["v8shim", "v8", "v8_libplatform", "stdc++"],
            "libs-osx": ["v8shim", "v8", "v8_libplatform", "c++"],
            "lflags-posix": ["-L$PACKAGE_DIR/vendor/v8shim"]
        },
        {
            "name": "unittest",
            "targetType": "library",
            "targetName": "dun-test",
            "versions": ["DunTest", "EngineQuickJS"],
            "preBuildCommands-posix": [
                "$DC -run $PACKAGE_DIR/build.d --backend=quickjs"
            ],
            "excludedSourceFiles": [
                "source/dun/engine/jsc/backend.d",
                "source/dun/engine/jsc/cppbindings.d",
                "source/dun/engine/v8/backend.d",
                "source/dun/engine/v8/cppbindings.d"
            ],
            "libs-posix": ["qjs"],
            "lflags-posix": ["-L$PACKAGE_DIR/vendor/quickjs/build"]
        }
    ]
}
