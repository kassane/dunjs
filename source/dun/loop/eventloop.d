/// Core event loop integrating eventcore with QuickJS job queue.
///
/// Phases per tick:
/// 1. Drain microtask queue (Promise continuations + queueMicrotask)
/// 2. Process expired timers (setTimeout/setInterval)
/// 3. Drain microtasks generated by timers
/// 4. Poll I/O (eventcore processEvents)
/// 5. Drain microtasks from I/O callbacks
module dun.loop.eventloop;

import dun.engine.bindings : JSRuntime, JSContext, JS_IsJobPending, JS_ExecutePendingJob;
import dun.loop.timers : TimerWheel;
import dun.loop.microtasks : MicrotaskQueue;

/// Central event loop. Coordinates async I/O, timers, and JS microtasks.
struct EventLoop
{
    TimerWheel timers;
    MicrotaskQueue microtasks;
    private JSRuntime* runtime;
    private bool running;
    private int outstandingRefs;

    /// Initialize the event loop with a QuickJS runtime.
    void initialize(JSRuntime* rt) @trusted
    {
        this.runtime = rt;
    }

    /// Run the event loop until no more work remains.
    void run() @trusted
    {
        running = true;
        while (running && hasWork())
        {
            tick();
        }
    }

    /// Execute one iteration of the event loop.
    void tick() @trusted
    {
        // Phase 1: Drain JS microtasks
        drainJobs();
        microtasks.drain();

        // Phase 2: Fire expired timers
        timers.processExpired();

        // Phase 3: Drain microtasks from timers
        drainJobs();
        microtasks.drain();

        // Phase 4: Poll I/O
        // TODO: Integrate eventcore.processEvents with timeout = nextDeadline
        // For now, this is a no-op until Phase 2 implementation

        // Phase 5: Drain post-I/O microtasks
        drainJobs();
        microtasks.drain();
    }

    /// Check if there is any pending work.
    bool hasWork() @trusted
    {
        return JS_IsJobPending(runtime) != 0 ||
            !timers.empty() ||
            !microtasks.empty() ||
            outstandingRefs > 0;
    }

    /// Stop the event loop.
    void stop()
    {
        running = false;
    }

    /// Register outstanding async work (e.g., open socket).
    void ref_()
    {
        outstandingRefs++;
    }

    /// Unregister outstanding async work.
    void unref()
    {
        if (outstandingRefs > 0)
            outstandingRefs--;
    }

    private void drainJobs() @trusted
    {
        while (JS_IsJobPending(runtime) != 0)
        {
            JSContext* pctx;
            JS_ExecutePendingJob(runtime, &pctx);
        }
    }
}
