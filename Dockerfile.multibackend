# DunJS Multi-Backend Container — CIS-hardened
#
# All three backends in one image, switchable via DUN_BACKEND env.
# Same CIS Docker Benchmark coverage as the single-backend Dockerfile:
#   4.1 non-root, 4.2 digest-pinned, 4.3 --no-install-recommends,
#   4.6 HEALTHCHECK, 4.7 update+install same RUN, 4.8 no SUID/SGID,
#   4.9 COPY over ADD, 4.10 no secrets, 4.11 sha256-verified toolchain.
#
# Recommended runtime flags:
#   docker run --read-only --tmpfs /tmp \
#     --cap-drop=ALL --security-opt no-new-privileges:true \
#     --pids-limit 256 --memory=512m dunjs:multi run script.js
#
# Usage:
#   docker build -f Dockerfile.multibackend -t dunjs:multi .
#   docker run --rm dunjs:multi run script.js                      # quickjs (default)
#   docker run --rm -e DUN_BACKEND=jsc dunjs:multi run script.js   # jsc
#   docker run --rm -e DUN_BACKEND=v8 dunjs:multi run script.js    # v8
#
# Multi-platform:
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     -f Dockerfile.multibackend -t dunjs:multi .

# ─── Stage 1: Build all backends ──────────────────────────────
FROM debian:bookworm-slim@sha256:67b30a61dc87758f0caf819646104f29ecbda97d920aaf5edc834128ac8493d3 AS build

ARG LDC_VERSION=1.42.0
# TARGETARCH is set automatically by buildx: "amd64" or "arm64"
ARG TARGETARCH

# CIS 4.11 — sha256s for the LDC toolchain tarballs.
ARG LDC_SHA256_AMD64=a7bc9c956138f558cadf9c962352f59d41c80df6eb3ae3f8039f25be14a69303
ARG LDC_SHA256_ARM64=687707c3e20ff910528eb2d92f27a98cb0960284de3b026e6bf20284ac1c8511

# g++ is required to compile vendor/v8shim/v8shim.cpp (V8 C++ shim)
# V8 14.9+ uses CREL relocations; linking handled by LDC --link-internally (LLVM 21)
# build.d auto-detects CRT paths for Debian/Ubuntu/Arch/RHEL via gcc -dumpmachine
# kassane/libv8 provides prebuilt binaries for both linux-x64 and linux-arm64
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl xz-utils tar gcc g++ cmake make pkg-config git bash \
    libxml2-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install LDC: download, verify sha256, extract.
RUN case "${TARGETARCH}" in \
      arm64) LDC_ARCH=aarch64; LDC_SHA="${LDC_SHA256_ARM64}" ;; \
      *)     LDC_ARCH=x86_64;  LDC_SHA="${LDC_SHA256_AMD64}" ;; \
    esac \
    && TARBALL="ldc2-${LDC_VERSION}-linux-${LDC_ARCH}.tar.xz" \
    && curl -sLO --fail "https://github.com/ldc-developers/ldc/releases/download/v${LDC_VERSION}/${TARBALL}" \
    && echo "${LDC_SHA}  ${TARBALL}" | sha256sum -c - \
    && tar -xJf "${TARBALL}" --directory /opt \
    && rm "${TARBALL}" \
    && ln -s /opt/ldc2-${LDC_VERSION}-linux-${LDC_ARCH}/bin/ldc2             /usr/bin/ldc2 \
    && ln -s /opt/ldc2-${LDC_VERSION}-linux-${LDC_ARCH}/bin/ldmd2            /usr/bin/ldmd2 \
    && ln -s /opt/ldc2-${LDC_VERSION}-linux-${LDC_ARCH}/bin/dub              /usr/bin/dub \
    && ln -s /opt/ldc2-${LDC_VERSION}-linux-${LDC_ARCH}/bin/ldc-build-plugin /usr/bin/ldc-build-plugin \
    && ln -s /opt/ldc2-${LDC_VERSION}-linux-${LDC_ARCH}/bin/ldc-build-runtime /usr/bin/ldc-build-runtime

WORKDIR /src
COPY . .
RUN mkdir -p vendor/sqlite vendor/v8/lib vendor/v8/include

# Download all vendor deps (build.d selects linux-x64 or linux-arm64 prebuilt automatically)
RUN ldc2 -run build.d --backend=all --force

# Per-arch -mcpu / -mattr baselines. Mirrors Zig std.Target defaults
# on LLVM 21 so we get a deterministic, portable CPU floor instead of
# leaving features '' (per ldc-developers/ldc#4919, named generic
# CPUs like x86-64-v3 resolve to empty feature sets). Applied to all
# three backend builds below.
#   amd64: Haswell+ baseline (AVX2 + FMA + BMI2)
#   arm64: ARMv8.0 + NEON, Cortex-A53 / Apple Silicon compatible
RUN case "${TARGETARCH:-amd64}" in \
      arm64) echo "--mcpu=generic -mattr=+enable-select-opt,+ete,+fp-armv8,+fuse-adrp-add,+fuse-aes,+neon,+trbe,+use-postra-scheduler" > /tmp/dflags ;; \
      *)     echo "--mcpu=x86-64-v3 -mattr=+64bit,+avx,+avx2,+bmi,+bmi2,+cmov,+crc32,+cx16,+cx8,+f16c,+fma,+fxsr,+lzcnt,+mmx,+movbe,+popcnt,+sahf,+sse,+sse2,+sse3,+sse4.1,+sse4.2,+ssse3,+x87,+xsave,+allow-light-256-bit,+false-deps-lzcnt-tzcnt,+false-deps-popcnt,+fast-15bytenop,+fast-scalar-fsqrt,+fast-shld-rotate,+fast-variable-crosslane-shuffle,+fast-variable-perlane-shuffle,+idivq-to-divl,+macrofusion,+nopl,+slow-3ops-lea,+vzeroupper" > /tmp/dflags ;; \
    esac \
    && echo "DFLAGS=$(cat /tmp/dflags)"

RUN export DFLAGS="$(cat /tmp/dflags)" && dub build -c quickjs -b release && strip build/dun && cp build/dun /tmp/dun-quickjs
RUN export DFLAGS="$(cat /tmp/dflags)" && dub build -c jsc -b release     && strip build/dun && cp build/dun /tmp/dun-jsc
# V8 build also produces build/icudtl.dat (V8 ICU data) via the
# dub.json postBuildCommands-posix hook. Stage it next to the v8
# binary; the runtime stage will copy it to /usr/local/bin/ so
# V8's `InitializeICUDefaultLocation(argv[0])` finds it.
RUN export DFLAGS="$(cat /tmp/dflags)" && dub build -c v8  -b release     && strip build/dun && cp build/dun /tmp/dun-v8 && cp build/icudtl.dat /tmp/icudtl.dat

# Build backend switcher (statically linked, runs anywhere)
RUN gcc -static -O2 -o /tmp/dun-switch docker/dun-switch.c && strip /tmp/dun-switch

# CIS 4.8 — strip SUID/SGID bits from every binary we plan to ship.
RUN for b in /tmp/dun-quickjs /tmp/dun-jsc /tmp/dun-v8 /tmp/dun-switch; do \
      find "$b" -perm /6000 -exec chmod a-s {} \; 2>/dev/null || true; \
    done

# Collect shared libs
RUN mkdir -p /deps/lib \
    && for bin in /tmp/dun-quickjs /tmp/dun-jsc /tmp/dun-v8; do \
      ldd "$bin" 2>/dev/null | grep "=> /" | awk '{print $3}' | while read lib; do \
        [ -f "$lib" ] && cp -anL "$lib" /deps/lib/ 2>/dev/null || true; \
      done; \
    done \
    && for lib in vendor/jsc/lib/*.so*; do \
      [ -f "$lib" ] && cp -a "$lib" /deps/lib/ 2>/dev/null || true; \
    done \
    && find /deps/lib -perm /6000 -exec chmod a-s {} \; 2>/dev/null || true

# ─── Stage 2: Runtime ────────────────────────────────────────
FROM debian:bookworm-slim@sha256:67b30a61dc87758f0caf819646104f29ecbda97d920aaf5edc834128ac8493d3

ARG BUILD_DATE="unknown"
ARG VCS_REF="unknown"
ARG VERSION="0.3.0"
LABEL org.opencontainers.image.title="DunJS Multi-Backend" \
      org.opencontainers.image.description="Secure JS/TS runtime with QuickJS, JSC, and V8 backends" \
      org.opencontainers.image.url="https://github.com/kassane/dunjs" \
      org.opencontainers.image.source="https://github.com/kassane/dunjs" \
      org.opencontainers.image.documentation="https://github.com/kassane/dunjs#readme" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="kassane" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${VERSION}-multi" \
      org.opencontainers.image.base.name="debian:bookworm-slim"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libstdc++6 libgcc-s1 libssl3 tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r -g 1001 dun \
    && useradd -r -u 1001 -g 1001 -d /app -s /usr/sbin/nologin -c "DunJS runtime user" dun \
    && mkdir -p /app \
    && chown -R 1001:1001 /app

COPY --from=build --chown=1001:1001 /tmp/dun-quickjs /usr/local/bin/dun-quickjs
COPY --from=build --chown=1001:1001 /tmp/dun-jsc     /usr/local/bin/dun-jsc
COPY --from=build --chown=1001:1001 /tmp/dun-v8      /usr/local/bin/dun-v8
COPY --from=build --chown=1001:1001 /deps/lib/       /usr/local/lib/
COPY --from=build --chown=1001:1001 /tmp/dun-switch  /usr/local/bin/dun
# V8 ICU data — without this, `DUN_BACKEND=v8 dun run any-Intl-script.js`
# fails with `Internal error. Icu error.` Putting it next to the
# binaries lets V8's `InitializeICUDefaultLocation(argv[0])` resolve
# the path automatically.
COPY --from=build --chown=1001:1001 /tmp/icudtl.dat  /usr/local/bin/icudtl.dat

# CIS 4.8 — final SUID/SGID scrub on the binaries that landed in /usr/local.
RUN find /usr/local/bin /usr/local/lib -xdev -perm /6000 -exec chmod a-s {} \; 2>/dev/null || true \
    && chmod 0555 /usr/local/bin/dun-quickjs /usr/local/bin/dun-jsc /usr/local/bin/dun-v8 /usr/local/bin/dun \
    && chmod 0444 /usr/local/bin/icudtl.dat \
    && ldconfig

ENV DUN_BACKEND="quickjs"

WORKDIR /app
USER 1001:1001

HEALTHCHECK --interval=30s --timeout=5s --start-period=2s --retries=2 \
    CMD ["/usr/local/bin/dun", "eval", "2+2===4 || process.exit(1)"]

STOPSIGNAL SIGTERM

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/dun"]
