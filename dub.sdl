name "dunjs"
description "A secure JavaScript runtime written in D"
authors "Matheus C. Franca"
license "MIT"

targetType "executable"
targetName "dun"

sourcePaths "source"
importPaths "source"
stringImportPaths "source"

lflags "-lm" "-ldl" "-lpthread" platform="linux"
lflags "-lm" "-lpthread" platform="osx"

configuration "quickjs" {
    versions "EngineQuickJS"
    lflags "-L$PACKAGE_DIR/vendor/quickjs" "-lquickjs" platform="posix"
}

configuration "jsc" {
    versions "EngineJSC"
}

configuration "hermes" {
    versions "EngineHermes"
}

configuration "unittest" {
    targetType "executable"
    targetName "dun-test"
    versions "DunTest"
    lflags "-L$PACKAGE_DIR/vendor/quickjs" "-lquickjs" platform="posix"
}
